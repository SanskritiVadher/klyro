# ==============================================================================
# Klyro Financial Intelligence - Environment Configuration
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
APP_NAME="Klyro Financial Intelligence"
DEBUG=true
PORT=8081
HOST=127.0.0.1

# Security & Sessions
SECRET_KEY=klyro-dev-super-secret-key-change-in-production-min-32-chars-long!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Settings
# Local SQLite database (production can swap to PostgreSQL: postgresql+psycopg2://user:password@localhost/kosh_db)
DATABASE_URL=sqlite:///./kosh.db

# Financial Defaults (India Context)
DEFAULT_CURRENCY=INR
CURRENCY_LOCALE=en_IN
FINANCIAL_YEAR_START_MONTH=4
SAFE_TO_SPEND_BUFFER_PCT=10
TIMEZONE=Asia/Kolkata

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:8081", "http://127.0.0.1:8081", "http://localhost:8081", "http://127.0.0.1:8081", "http://localhost:3000"]
