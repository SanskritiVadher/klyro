                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sanskriti@klyro.finance\",\n  \"password\": \"DemoPassword123!\"\n}"
